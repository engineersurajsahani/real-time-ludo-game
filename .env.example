# ---------------------------------------------------------------------------
# Real-time Ludo Game - environment variables
# Copy to `.env` for local work. On Render, set these in the dashboard instead.
# ---------------------------------------------------------------------------

# Which mode to run in: production enables strict CSP/HSTS and refuses to boot
# without a database. Defaults to "development".
NODE_ENV=development

# MongoDB Atlas connection string. Required in production for chat persistence.
# Atlas -> Connect -> Drivers -> copy the string, swap <password>, and add a
# database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ludo?retryWrites=true&w=majority

# Escape hatch for intentionally running production without persistence.
# ALLOW_MEMORY_CHAT=true

# HTTP port. Render sets this automatically; 3000 locally.
PORT=3000

# Trust the X-Forwarded-For header (one proxy hop). Enabled automatically in
# production; only turn it off if the app is exposed directly to the internet.
# TRUST_PROXY=true

# Extra browser origins allowed to open a websocket, comma separated.
# Leave EMPTY in production: the front-end is served by this same app, so
# same-origin is enforced by default. Never put "*" here.
# ALLOWED_ORIGINS=https://ludo.example.com

# --- abuse limits (optional overrides) -------------------------------------
# MAX_ROOMS=500
# MAX_ROOM_CONNECTIONS=12
# MAX_IP_CONNECTIONS=20
# SOCKET_MAX_BUFFER=65536
